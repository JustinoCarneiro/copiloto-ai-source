# Copiloto AI — self-host na VPS. Copie para `.env` (mesma pasta deploy/) e preencha.
# NUNCA commitar o `.env` real — só este .example. Gerar valores novos, não reaproveitar
# nenhum segredo do Supabase Cloud atual (são ambientes diferentes).
#
# Nota: alguns valores aparecem duplicados de propósito (ex.: a mesma chave em
# ANON_KEY/SUPABASE_ANON_KEY/VITE_SUPABASE_PUBLISHABLE_KEY). É intencional — não usar
# `${VAR}` encadeado dentro deste arquivo pra não depender de como cada versão do Docker
# Compose resolve interpolação de .env. Copie o mesmo valor nos três lugares.

# ---------- Domínios ----------
# Só documentação/referência aqui — quem lê estes valores é você, ao editar
# deploy/nginx-vhost-example.conf (nginx do sistema, não Docker; ver RUNBOOK.md).
APP_DOMAIN=app.seudominio.com.br
API_DOMAIN=api.seudominio.com.br

# ---------- Postgres ----------
# Senha do superusuário do Postgres self-hosted. Gerar com: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ---------- JWT / chaves da API (self-host) ----------
# 1. Gerar JWT_SECRET com: openssl rand -base64 40   (mínimo 32 caracteres)
# 2. Preencher JWT_SECRET abaixo
# 3. Rodar: node deploy/generate-jwt-keys.js
#    (o script lê JWT_SECRET deste arquivo e imprime ANON_KEY e SERVICE_ROLE_KEY prontos)
# 4. Colar cada chave gerada em TODOS os campos correspondentes deste arquivo (ver nota acima)
JWT_SECRET=

ANON_KEY=
SERVICE_ROLE_KEY=

# ---------- Studio (painel admin, atrás de basic auth no Kong) ----------
DASHBOARD_USERNAME=admin
# Gerar com: openssl rand -base64 24
DASHBOARD_PASSWORD=

# ---------- URLs usadas pelo Auth (GoTrue) ----------
SITE_URL=https://app.seudominio.com.br
API_EXTERNAL_URL=https://api.seudominio.com.br

# ---------- Login com Google (OAuth nativo do GoTrue) ----------
# Criar em https://console.cloud.google.com/ → APIs e Serviços → Credenciais → Criar credenciais
# → ID do cliente OAuth → Aplicativo da Web. Em "URIs de redirecionamento autorizados", cadastrar
# EXATAMENTE: https://api.seudominio.com.br/auth/v1/callback (troque pelo seu API_DOMAIN real).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Segredos das edge functions (mesmos nomes que o código já espera, ver
# supabase/functions/**/index.ts) ----------
# SUPABASE_URL: dentro da rede Docker as functions falam com o Kong pelo nome do serviço.
SUPABASE_URL=http://kong:8000
# Colar aqui o MESMO valor de ANON_KEY acima.
SUPABASE_ANON_KEY=
# Colar aqui o MESMO valor de SERVICE_ROLE_KEY acima.
SUPABASE_SERVICE_ROLE_KEY=

# Token de produção do Mercado Pago (painel MP → Credenciais). NUNCA o de teste/sandbox aqui.
MERCADO_PAGO_ACCESS_TOKEN=
# Token que você mesmo escolhe e configura como querystring do webhook no painel do MP
# (?token=...). Gerar com: openssl rand -hex 32
MP_WEBHOOK_TOKEN=
PAYMENT_GATEWAY=mercadopago
# URL pra onde o Mercado Pago redireciona depois do checkout.
APP_URL=https://app.seudominio.com.br/assinatura

# Chave da Lovable AI Gateway (chat-ia e voice-transcribe) — mesma do ambiente atual, é um
# serviço externo, continua funcionando independente de onde o resto roda.
LOVABLE_API_KEY=

# ---------- Frontend (build-time, Vite — viram build args no docker-compose.yml) ----------
VITE_SUPABASE_URL=https://api.seudominio.com.br
# Colar aqui o MESMO valor de ANON_KEY acima.
VITE_SUPABASE_PUBLISHABLE_KEY=
